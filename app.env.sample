# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=navidrome.example.com

APP_ORG_NAME=Navidrome

# log trace, debug, info, warn or error
NAVIDROME_LOG_LEVEL=info

# How often a full library scan runs, Go duration such as 1h or 6h
NAVIDROME_SCAN_SCHEDULE=1h

# How long the filesystem watcher waits before re-scanning, Go duration
NAVIDROME_SCANNER_WATCHER_WAIT=300s

# Session length, Go duration such as 24h or 8766h
NAVIDROME_SESSION_TIMEOUT=24h

# Web UI theme, Dark or Light
NAVIDROME_DEFAULT_THEME=Dark

# On disk cover art cache size, such as 100MB or 2G
NAVIDROME_IMAGE_CACHE_SIZE=100MB

# Where automatic database backups are written inside the data volume
NAVIDROME_BACKUP_PATH=/data/backups

# How many automatic backups to keep
NAVIDROME_BACKUP_COUNT=1
